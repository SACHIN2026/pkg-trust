{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "node",
      "strict": true,
      "outDir": "dist",
      "types": ["node"],
      "ignoreDeprecations": "6.0",
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }